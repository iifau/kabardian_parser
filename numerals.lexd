PATTERN DistrHyph
TenPlus Over One [<distr>:-] :TenPlus :Over :One
TenPlus Over TwoFive [<distr>:-] :TenPlus :Over :TwoFive
TenPlus Over SixNine [<distr>:-] :TenPlus :Over :SixNine
TensStem[lit] TenBy[lit] [<distr>:-] :TensStem[lit] :TenBy[lit]
TensStem[kub] TenBy[kub] [<distr>:-] :TensStem[kub] :TenBy[kub]
TensStem[malk] TenBy[malk] [<distr>:-] :TensStem[malk] :TenBy[malk]
TensStem[bes] TenBy[bes] [<distr>:-] :TensStem[bes] :TenBy[bes]
TensIrregular [<distr>:-] :TensIrregular
HundredBy TwoFive [<distr>:-] :HundredBy :TwoFive
HundredBy SixNine [<distr>:-] :HundredBy :SixNine
HigherPowers [<distr>:-] :HigherPowers
HigherPowers [:-] DistrPower

